{
  "name": "the-roost",
  "version": "1.0.0",
  "description": "Animal Crossing-Based Pomodoro Timer",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.theroost.app",
    "productName": "The Roost",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "isabelle.ico"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "renderer.js",
      "style.css",
      "ambience/**/*",
      "fx/**/*",
      "font/**/*",
      "OSTs/**/*",         
      "album-covers/**/*", 
      "*.png",
      "*.jpg",
      "*.gif"
    ]
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.0"
  }
}